# Vercel & Production Environment Variables
# Add these in Vercel Dashboard > Project Settings > Environment Variables

# MongoDB Atlas Connection URI (Required for production on Vercel)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/landestate?retryWrites=true&w=majority

# JWT Secret for authentication tokens (Required)
JWT_SECRET=your_super_secret_jwt_key_here

# Environment Mode
NODE_ENV=production
